  "id": "08-searching",
  "title": "Searching Algorithms",
  "category": "fundamentals",
  "theory": {
    "overview": "Searching algorithms find the position of a target value within a data structure. Linear Search checks each element sequentially (O(n)). Binary Search repeatedly divides a sorted array in half (O(log n)). More advanced techniques include Interpolation Search for uniformly distributed data, Exponential Search for unbounded arrays, and Ternary Search for finding maxima/minima in unimodal functions.",
    "keyConcepts": [
      {
        "name": "Linear Search",
        "description": "Check each element from start to end. O(n) time, works on unsorted data. Simple but slow for large datasets."
      },
      {
        "name": "Binary Search",
        "description": "Divide sorted array in half, eliminate wrong half. O(log n). Requires sorted data, extremely efficient."
      },
      {
        "name": "Lower/Upper Bound",
        "description": "Find first position ≥ target (lower) or > target (upper). Essential for range queries and insertions."
      },
      {
        "name": "Search Space Reduction",
        "description": "Technique for optimization problems: define search space, use predicate to binary search for optimal value."
      }
    ],
    "complexity": {
      "linearSearch": "O(n)",
      "binarySearch": "O(log n)",
      "interpolation": "O(log log n) average",
      "exponential": "O(log n)"
    }
  },
