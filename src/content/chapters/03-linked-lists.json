{
  "id": "03-linked-lists",
  "title": "Linked Lists",
  "category": "fundamentals",
  "theory": {
    "overview": "A linked list is a linear data structure where elements are stored in nodes, and each node points to the next node in the sequence. Unlike arrays, linked lists don't require contiguous memory allocation, allowing for efficient insertion and deletion at any position. Each node contains data and a reference (pointer) to the next node. The first node is called the head, and the last node points to null.",
    "keyConcepts": [
      {
        "name": "Nodes and Pointers",
        "description": "Each node contains data and a pointer to the next node. The pointer is essentially a memory address referencing the next node's location."
      },
      {
        "name": "Head and Tail",
        "description": "The head is the first node in the list. The tail is the last node, which has its next pointer set to null."
      },
      {
        "name": "Singly vs Doubly Linked",
        "description": "Singly linked lists have one pointer (next). Doubly linked lists have two pointers (next and prev), allowing traversal in both directions."
      },
      {
        "name": "Dynamic Size",
        "description": "Linked lists grow and shrink dynamically. No pre-allocation needed, and no wasted memory from unused capacity."
      }
    ],
    "complexity": {
      "access": "O(n)",
      "search": "O(n)",
      "insertion": "O(1) at head, O(n) elsewhere",
      "deletion": "O(1) at head, O(n) elsewhere",
      "space": "O(n)"
    }
  },
