{
  "id": "10-bst",
  "title": "Binary Search Trees",
  "category": "intermediate",
  "theory": {
    "overview": "A Binary Search Tree (BST) is a node-based binary tree data structure with the property that for each node, all values in the left subtree are smaller, and all values in the right subtree are larger. This ordering enables efficient O(log n) search, insertion, and deletion in a balanced tree. BSTs are the foundation for ordered maps, sets, and database indexing structures.",
    "keyConcepts": [
      {
        "name": "BST Property",
        "description": "For any node: left subtree values < node.value < right subtree values. This must hold for ALL nodes, not just immediate children."
      },
      {
        "name": "Tree Traversals",
        "description": "Inorder (left-root-right) gives sorted order. Preorder (root-left-right) for copying. Postorder (left-right-root) for deletion."
      },
      {
        "name": "Balanced vs Unbalanced",
        "description": "Balanced BSTs (AVL, Red-Black) guarantee O(log n) operations. Unbalanced can degrade to O(n) linked list."
      },
      {
        "name": "Successor/Predecessor",
        "description": "Inorder successor is minimum of right subtree (or parent where we went left). Predecessor is maximum of left subtree."
      }
    ],
    "complexity": {
      "search": "O(log n) balanced, O(n) worst",
      "insert": "O(log n) balanced, O(n) worst",
      "delete": "O(log n) balanced, O(n) worst",
      "space": "O(n)"
    }
  },
